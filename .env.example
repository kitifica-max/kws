# Pinterest API v5 credentials for the pinterest-design-research skill.
#
# Copy this file to .env (same folder, repo root) and fill in the real
# values there. .env is gitignored — never commit real credentials.
# See .claude/skills/pinterest-design-research/references/api-reference.md
# for how to obtain each value.

# From https://developers.pinterest.com/apps/ — your app's Client ID / secret.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# The redirect URI you registered on the app (any HTTPS URL works for
# personal use — you just read the ?code=... param out of the address bar).
PINTEREST_REDIRECT_URI=

# Filled in automatically by `pinterest_client.py exchange-code` / `refresh`.
# Leave these blank — do not hand-edit after the first OAuth exchange.
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_TOKEN_EXPIRES_AT=

# Only set to "true" if Pinterest has approved your app for the beta
# /search/partner/pins endpoint (rare). Leave "false" otherwise — the
# skill's main workflow doesn't need it.
PINTEREST_PARTNER_SEARCH_ENABLED=false

# --- Optional: remote proxy client (scripts/pinterest_proxy_client.py) ---
# Only needed if you're using the Netlify proxy instead of the direct OAuth
# flow above — see .claude/skills/pinterest-design-research/references/remote-proxy.md.
# With these two set, no Pinterest app id/secret/tokens are needed locally.
PINTEREST_PROXY_URL=
PINTEREST_PROXY_SECRET=
